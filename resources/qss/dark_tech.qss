/* LoveAI v3.0 dark_tech.qss（默认深色科技风）
   设计规则：4级排版/8px基数间距/触控≥36px/卡片12px圆角1px边框/对比度≥4.5:1/无嵌套卡片 */
QWidget {
    color:#e0e0e0; background-color:#0a0a1a; font-family:"Microsoft YaHei"; font-size:10pt;
}
QMainWindow,QDialog { background-color:#0a0a1a; }

/* === 排版层级（H1 20pt粗 / H2 16pt粗 / H3 13pt中 / 正文 10pt）=== */
QLabel#h1 { color:#f0f0ff; font-size:20pt; font-weight:700; }
QLabel#h2 { color:#f0f0ff; font-size:16pt; font-weight:700; }
QLabel#h3 { color:#a855f7; font-size:13pt; font-weight:600; }
QLabel#body { color:#e0e0e0; font-size:10pt; }
QLabel#subText { color:#8888aa; font-size:9pt; }            /* 辅助文字对比度约5:1 */
QLabel#emptyState { color:#8888aa; font-size:11pt; }
QLabel#errorState { color:#ef4444; font-size:10pt; }
QLabel#bigScore { color:qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #a855f7, stop:1 #ec4899);
    font-size:32pt; font-weight:700; }

/* === 卡片（毛玻璃，12px圆角，1px紫边，禁止嵌套）=== */
QFrame#panel,QGroupBox {
    background-color:rgba(30,30,60,0.7); border:1px solid rgba(168,85,247,0.2); border-radius:12px;
}

/* === 导航（项高44px）=== */
QListWidget { background:rgba(20,20,45,0.85); border:none; border-radius:8px; padding:8px; }
QListWidget::item { padding:10px 16px; border-radius:8px; color:#a0a0c0; min-height:24px; }
QListWidget::item:selected { background:qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #a855f7, stop:1 #3b82f6); color:#fff; }

/* === 按钮（触控≥36px，水平16 垂直8）=== */
QPushButton {
    min-height:36px; padding:8px 16px; border:none; border-radius:20px;
    background:qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #a855f7, stop:1 #3b82f6);
    color:#fff; font-weight:600;
}
QPushButton:hover { background:qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #c084fc, stop:1 #60a5fa); }
QPushButton:pressed { background:#7c3aed; }
QPushButton:disabled { background:#3a3a55; color:#9a9ab0; }   /* 禁用对比度≥3:1 */
QPushButton[cssClass="danger"] { background:#ef4444; }
QPushButton[cssClass="success"] { background:#10b981; }

/* === 输入（高36px）=== */
QLineEdit,QTextEdit,QComboBox,QSpinBox {
    min-height:24px; padding:6px 8px; border:1px solid rgba(168,85,247,0.3); border-radius:8px;
    background-color:rgba(40,40,75,0.8); color:#e0e0e0;
}
QLineEdit:focus,QTextEdit:focus { border:1px solid #a855f7; }

/* === 进度条（渐变仅用于填充，发光感）=== */
QProgressBar { border:none; border-radius:8px; background:rgba(40,40,75,0.8); height:10px; text-align:center; color:#8888aa; }
QProgressBar::chunk { background:qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #a855f7, stop:1 #3b82f6); border-radius:8px; }

/* === 标签页/表格 === */
QTabWidget::pane { border:1px solid rgba(168,85,247,0.2); border-radius:8px; }
QTabBar::tab { padding:8px 16px; border-radius:8px; color:#a0a0c0; min-height:20px; }
QTabBar::tab:selected { background:rgba(168,85,247,0.3); color:#fff; }
QTableWidget { background:rgba(20,20,45,0.85); gridline-color:rgba(168,85,247,0.15); border-radius:8px; }
QHeaderView::section { background:rgba(30,30,60,0.9); color:#a0a0c0; border:none; padding:8px; }

/* === 滚动条 === */
QScrollBar:vertical { background:transparent; width:8px; }
QScrollBar::handle:vertical { background:rgba(168,85,247,0.5); border-radius:4px; }
QScrollBar::add-line,QScrollBar::sub-line { height:0; }
