/* LoveAI v3.0 eye_pink.qss 护眼粉 */
QWidget { color:#3a2030; background-color:#fff5f7; font-family:"Microsoft YaHei"; font-size:10pt; }
QLabel#h1 { color:#3a2030; font-size:20pt; font-weight:700; }
QLabel#h2 { color:#3a2030; font-size:16pt; font-weight:700; }
QLabel#h3 { color:#ec4899; font-size:13pt; font-weight:600; }
QLabel#emptyState { color:#b08090; font-size:11pt; }
QLabel#errorState { color:#ef4444; font-size:10pt; }
QMainWindow,QDialog { background:qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #fff5f7, stop:1 #ffe4ec); }
QFrame#panel,QGroupBox { background:rgba(255,255,255,0.85); border:1px solid #fbcfe8; border-radius:12px; }
QListWidget::item { padding:10px 14px; border-radius:8px; }
QListWidget::item:selected { background:linear-gradient(90deg,#ec4899,#f9a8d4); color:#fff; }
QPushButton { background:linear-gradient(90deg,#ec4899,#f472b6); color:#fff; border:none; border-radius:20px; padding:8px 18px; font-weight:bold; }
QLineEdit,QTextEdit,QComboBox { background:#fff; border:1px solid #fbcfe8; border-radius:8px; padding:6px; }
QProgressBar { border:none; border-radius:8px; background:#ffe4ec; height:10px; }
QProgressBar::chunk { background:linear-gradient(90deg,#ec4899,#f9a8d4); border-radius:8px; }
QScrollBar:vertical { width:8px; background:transparent; }
QScrollBar::handle:vertical { background:#f9a8d4; border-radius:4px; }
