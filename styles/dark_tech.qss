/* LoveAI v3.0 深色科技风 dark_tech.qss（默认）*/
QWidget {
    color: #f0f0ff;
    background-color: #0a0a1a;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 14px;
}
QMainWindow, QDialog { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:1,
    stop:0 #0a0a1a, stop:0.5 #1a1a2e, stop:1 #16213e); }

/* 毛玻璃面板 */
QFrame#panel, QGroupBox, QCard {
    background-color: rgba(30,30,60,0.7);
    border: 1px solid rgba(168,85,247,0.25);
    border-radius: 12px;
}

/* 导航 */
QListWidget, QTreeWidget {
    background-color: rgba(20,20,45,0.85);
    border: none;
    border-radius: 8px;
    padding: 4px;
}
QListWidget::item { padding: 10px 14px; border-radius: 8px; color: #a0a0c0; }
QListWidget::item:selected {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #a855f7, stop:1 #3b82f6);
    color: #ffffff;
}

/* 按钮 */
QPushButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #a855f7, stop:1 #3b82f6);
    color: #ffffff; border: none; border-radius: 20px; padding: 8px 18px;
    font-weight: bold;
}
QPushButton:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #c084fc, stop:1 #60a5fa); }
QPushButton:pressed { background: #7c3aed; }
QPushButton[cssClass="danger"] { background: #ef4444; }
QPushButton[cssClass="success"] { background: #10b981; }

/* 输入 */
QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background-color: rgba(40,40,75,0.8);
    border: 1px solid rgba(168,85,247,0.3);
    border-radius: 8px; padding: 6px; color: #f0f0ff;
}
QLineEdit:focus, QTextEdit:focus { border: 1px solid #a855f7; }

/* 标签/文字 */
QLabel#bigScore { font-size: 42px; font-weight: bold;
    color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #a855f7, stop:1 #ec4899); }
QLabel#subText { color: #a0a0c0; }

/* 进度条 */
QProgressBar { border: none; border-radius: 8px; background: rgba(40,40,75,0.8); height: 10px; text-align: center; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #a855f7, stop:1 #3b82f6); border-radius: 8px; }

/* 表格/标签页 */
QTabWidget::pane { border: 1px solid rgba(168,85,247,0.25); border-radius: 8px; }
QTabBar::tab { background: rgba(30,30,60,0.7); padding: 8px 16px; border-radius: 8px; color:#a0a0c0; }
QTabBar::tab:selected { background: rgba(168,85,247,0.3); color:#fff; }
QTableWidget { background: rgba(20,20,45,0.85); gridline-color: rgba(168,85,247,0.15); border-radius:8px; }
QHeaderView::section { background: rgba(30,30,60,0.9); color:#a0a0c0; border:none; padding:6px; }

/* 滚动条 */
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: rgba(168,85,247,0.5); border-radius: 4px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
